@implements IAsyncDisposable
@inject AgentApiClient Api
@inject AgentProcessController AgentProcess

<div class="shell">
    <aside class="sidebar">
        <div class="brand">MateMCP Companion</div>
        <nav class="nav" aria-label="Companion navigation">
            <button class="@(Section == "dashboard" ? "active" : null)" @onclick='() => Section = "dashboard"'>
                <Icon Value="@FluentIcons.Home" />
                <span>Dashboard</span>
            </button>
            <button class="@(Section == "devices" ? "active" : null)" @onclick='() => Section = "devices"'>
                <Icon Value="@FluentIcons.Settings" />
                <span>Devices</span>
            </button>
            <button class="@(Section == "approvals" ? "active" : null)" @onclick='() => Section = "approvals"'>
                <Icon Value="@FluentIcons.Checkmark" />
                <span>Approvals (@Approvals.Count)</span>
            </button>
            <button class="@(Section == "shell" ? "active" : null)" @onclick='() => Section = "shell"'>
                <Icon Value="@FluentIcons.Code" />
                <span>Shell@(ActiveShellCount > 0 ? $" ({ActiveShellCount})" : string.Empty)</span>
            </button>
            <button class="@(Section == "secrets" ? "active" : null)" @onclick='() => Section = "secrets"'>
                <Icon Value="@FluentIcons.Settings" />
                <span>Secrets</span>
            </button>
            <button class="@(Section == "audit" ? "active" : null)" @onclick='() => Section = "audit"'>
                <Icon Value="@FluentIcons.Document" />
                <span>Activity</span>
            </button>
        </nav>
    </aside>

    <main class="content">
        <div class="toolbar">
            <div>
                <h1>@Title</h1>
                <div class="muted">Local Agent management</div>
            </div>
            <Button Text="Refresh" Icon="@FluentIcons.ArrowSyncCircle" OnClick="RefreshAllAsync" />
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error">@Error</div>
        }

        @if (Section == "dashboard")
        {
            <div class="grid">
                <div class="panel">
                    <div class="muted">Agent</div>
                    <div class="metric agent-status @(AgentRunning ? "online" : "stopped")">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span>@AgentStateLabel</span>
                    </div>
                    <div class="muted">Local background process</div>
                    <div class="actions">
                        @if (LifecycleBusy)
                        {
                            <span class="muted">@LifecycleMessage</span>
                        }
                        else if (AgentRunning)
                        {
                            <Button Text="Restart" OnClick="RestartAgentAsync" />
                            <Button Text="Stop" OnClick="StopAgentAsync" />
                        }
                        else
                        {
                            <Button Text="Start" OnClick="StartAgentAsync" />
                        }
                    </div>
                    @if (!LifecycleBusy && !string.IsNullOrWhiteSpace(LifecycleMessage))
                    {
                        <div class="muted" style="margin-top:8px">@LifecycleMessage</div>
                    }
                </div>
                <div class="panel"><div class="muted">Pending approvals</div><div class="metric">@Approvals.Count</div></div>
                <div class="panel"><div class="muted">Interactive sessions</div><div class="metric">@(Status?.InteractiveSessions ?? ActiveShellCount)</div></div>
                <div class="panel"><div class="muted">Credential store</div><div class="metric" style="font-size:18px">@(Status?.Credentials ?? (AgentRunning ? "Starting…" : "Agent stopped"))</div></div>
            </div>
            <DesktopUpdatePanel />
            @if (Status is not null)
            {
                <div class="panel">
                    <strong>Connection</strong>
                    <div class="row">
                        <span class="muted">MateMCP API</span>
                        <div><a class="link" href="@ControlPlaneUrl" target="_blank" rel="noopener noreferrer">@ControlPlaneUrl</a></div>
                    </div>
                    <div class="row">
                        <span class="muted">Relay</span>
                        @if (Status.Relay.Enabled)
                        {
                            <div><a class="link" href="@Status.Relay.Url" target="_blank" rel="noopener noreferrer">@Status.Relay.Url</a></div>
                        }
                        else
                        {
                            <div>Disabled</div>
                        }
                    </div>
                    <div class="row">
                        <span class="muted">Device MCP URL</span>
                        @if (DeviceMcpUrl is not null)
                        {
                            <div><a class="link" href="@DeviceMcpUrl" target="_blank" rel="noopener noreferrer">@DeviceMcpUrl</a></div>
                            <div class="actions">
                                <Button Text="Copy" OnClick="CopyDeviceMcpUrlAsync" />
                                @if (DeviceUrlCopied)
                                {
                                    <span class="muted copy-note">Copied</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="muted">Available after this Agent is enrolled and connected to Relay.</div>
                        }
                    </div>
                    <div class="row"><span class="muted">Device ID</span><div>@(Status.Relay.DeviceId ?? "Not enrolled")</div></div>
                    <div class="row"><span class="muted">Local management</span><div><a class="link" href="@Status.Management" target="_blank" rel="noopener noreferrer">@Status.Management</a></div></div>
                    <div class="row"><span class="muted">Projects</span><div>@string.Join(", ", Status.Projects)</div></div>
                    <div class="row"><span class="muted">Configuration</span><div>@Status.Configuration</div></div>
                </div>
            }
            else if (!AgentRunning)
            {
                <div class="panel">
                    <strong>Agent is stopped</strong>
                    <div class="muted" style="margin-top:8px">The Companion remains available so you can start the Agent again without using a terminal.</div>
                </div>
            }
        }
        else if (Section == "devices")
        {
            <DevicesPanel />
        }
        else if (Section == "approvals")
        {
            <div class="panel">
                @if (Approvals.Count == 0)
                {
                    <div class="muted">No pending approval requests.</div>
                }
                else
                {
                    <div class="list">
                        @foreach (var approval in Approvals)
                        {
                            <div class="row" @key="approval.Id">
                                <strong>@approval.Capability</strong>
                                <div>@approval.Target</div>
                                <div class="muted">@approval.Summary</div>
                                <div class="actions">
                                    <Button Text="Approve" OnClick='() => DecideAsync(approval.Id, "allow")' />
                                    <Button Text="Approve for session" OnClick='() => DecideAsync(approval.Id, "allow-session")' />
                                    <Button Text="Always allow" OnClick='() => DecideAsync(approval.Id, "allow-always")' />
                                    <Button Text="Deny" OnClick='() => DecideAsync(approval.Id, "deny")' />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (Section == "shell")
        {
            <div class="session-layout">
                <div class="panel">
                    <strong>Sessions</strong>
                    @if (ShellSessions.Count == 0)
                    {
                        <div class="muted" style="margin-top:10px">No active interactive sessions.</div>
                    }
                    @foreach (var session in ShellSessions)
                    {
                        <div class="session-item @(SelectedSessionId == session.SessionId ? "active" : null)" @onclick="() => SelectShellAsync(session.SessionId)" @key="session.SessionId">
                            <strong>@session.SessionId[..Math.Min(8, session.SessionId.Length)]</strong>
                            <div class="muted">PID @session.ProcessId · @(session.Exited ? $"Exited {session.ExitCode}" : "Running")</div>
                            <div class="muted">@session.WorkingDirectory</div>
                        </div>
                    }
                </div>
                <div class="panel">
                    @if (SelectedSessionId is null)
                    {
                        <div class="muted">Select a session to inspect its live output.</div>
                    }
                    else
                    {
                        <div class="terminal">@ShellOutput</div>
                        <div class="field" style="margin-top:12px">
                            <label>Input</label>
                            <input @bind="ShellInput" @onkeydown="HandleShellKeyDown" placeholder="Send input to the running process" />
                        </div>
                        <div class="actions">
                            <Button Text="Send" OnClick="SendShellInputAsync" />
                            <Button Text="Terminate" OnClick="CloseSelectedShellAsync" />
                        </div>
                    }
                </div>
            </div>
        }
        else if (Section == "secrets")
        {
            <div class="grid">
                <div class="panel">
                    <strong>Add / replace secret</strong>
                    <div class="field"><label>Name</label><input @bind="SecretName" autocomplete="off" /></div>
                    <div class="field"><label>Description</label><input @bind="SecretDescription" /></div>
                    <div class="field"><label>Secret value</label><input type="password" @bind="SecretValue" autocomplete="new-password" /></div>
                    <div class="field"><label>Allowed tools (comma separated)</label><input @bind="SecretAllowedTools" placeholder="shell_session_send_secret" /></div>
                    <Button Text="Save secret" OnClick="SaveSecretAsync" />
                    <div class="muted" style="margin-top:10px">Secret values are sent only to the loopback Agent API and are never read back or shown in this UI.</div>
                </div>
                <div class="panel">
                    <strong>Stored secrets</strong>
                    @if (Secrets.Count == 0)
                    {
                        <div class="muted" style="margin-top:10px">No stored secrets.</div>
                    }
                    @foreach (var secret in Secrets)
                    {
                        <div class="row" @key="secret.Name">
                            <strong>@secret.Name</strong>
                            <div>@secret.Description</div>
                            <div class="muted">Allowed: @string.Join(", ", secret.AllowedTools ?? new[] { "shell_session_send_secret" })</div>
                            <div class="actions"><Button Text="Delete" OnClick="() => DeleteSecretAsync(secret.Name)" /></div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Section == "audit")
        {
            <div class="panel">
                @if (Audit.Count == 0)
                {
                    <div class="muted">No activity recorded yet.</div>
                }
                @foreach (var item in Audit)
                {
                    <div class="row">
                        <strong>@item.Capability</strong>
                        <span class="muted"> · @item.Timestamp.LocalDateTime</span>
                        <div>@item.Target</div>
                        <div class="muted">@item.Result@if (!string.IsNullOrWhiteSpace(item.Credential)) { <text> · credential: @item.Credential</text> }@if (!string.IsNullOrWhiteSpace(item.Tool)) { <text> · tool: @item.Tool</text> }</div>
                    </div>
                }
            </div>
        }
    </main>
</div>
<Containers />

@code {
    private const string ControlPlaneUrl = "https://api.matemcp.com";
    private readonly CancellationTokenSource _disposeCts = new();
    private Task? _pollTask;
    private string Section { get; set; } = "dashboard";
    private string? Error { get; set; }
    private AgentStatus? Status { get; set; }
    private bool AgentRunning { get; set; }
    private bool LifecycleBusy { get; set; }
    private string? LifecycleMessage { get; set; }
    private IReadOnlyList<PendingApproval> Approvals { get; set; } = [];
    private IReadOnlyList<UserSecretInfo> Secrets { get; set; } = [];
    private IReadOnlyList<ShellSessionSnapshot> ShellSessions { get; set; } = [];
    private IReadOnlyList<AuditEntry> Audit { get; set; } = [];
    private string? SelectedSessionId { get; set; }
    private int ShellOffset { get; set; }
    private string ShellOutput { get; set; } = string.Empty;
    private string ShellInput { get; set; } = string.Empty;
    private string SecretName { get; set; } = string.Empty;
    private string SecretDescription { get; set; } = string.Empty;
    private string SecretValue { get; set; } = string.Empty;
    private string SecretAllowedTools { get; set; } = "shell_session_send_secret";
    private bool DeviceUrlCopied { get; set; }

    private int ActiveShellCount => ShellSessions.Count(x => !x.Exited);
    private string AgentStateLabel => AgentRunning ? (Status is null ? "Starting…" : "Online") : "Stopped";

    private string? DeviceMcpUrl => Status?.Relay is { Enabled: true, Url: { Length: > 0 } relayUrl, DeviceId: { Length: > 0 } deviceId }
        ? $"{relayUrl.TrimEnd('/')}/mcp/{Uri.EscapeDataString(deviceId)}"
        : null;

    private string Title => Section switch
    {
        "devices" => "Devices & Account",
        "approvals" => "Approval Center",
        "shell" => "Interactive Shell",
        "secrets" => "Secret Manager",
        "audit" => "Activity & Audit",
        _ => "Dashboard"
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
        _pollTask = PollAsync(_disposeCts.Token);
    }

    private async Task RefreshAllAsync()
    {
        AgentRunning = AgentProcess.IsRunning();
        if (!AgentRunning)
        {
            ClearAgentData();
            DeviceUrlCopied = false;
            Error = null;
            return;
        }

        try
        {
            Status = await Api.GetStatusAsync(_disposeCts.Token);
            Approvals = await Api.GetApprovalsAsync(_disposeCts.Token);
            Secrets = await Api.GetSecretsAsync(_disposeCts.Token);
            ShellSessions = await Api.GetShellSessionsAsync(_disposeCts.Token);
            ReconcileSelectedShell();
            Audit = await Api.GetAuditAsync(250, _disposeCts.Token);
            DeviceUrlCopied = false;
            Error = null;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Status = null;
            Error = $"Agent process is running but its local API is unavailable: {ex.Message}";
        }
    }

    private async Task RefreshDynamicAsync()
    {
        AgentRunning = AgentProcess.IsRunning();
        if (!AgentRunning)
        {
            ClearAgentData();
            Error = null;
            return;
        }

        try
        {
            Status = await Api.GetStatusAsync(_disposeCts.Token);
            Approvals = await Api.GetApprovalsAsync(_disposeCts.Token);
            ShellSessions = await Api.GetShellSessionsAsync(_disposeCts.Token);
            ReconcileSelectedShell();
            if (SelectedSessionId is not null)
            {
                var snapshot = await Api.ReadShellSessionAsync(SelectedSessionId, ShellOffset, _disposeCts.Token);
                if (snapshot is null) ClearSelectedShell();
                else
                {
                    if (snapshot.OutputTruncated) ShellOutput += "\n[older output truncated]\n";
                    ShellOutput += snapshot.Output;
                    ShellOffset = snapshot.NextOffset;
                }
            }
            Error = null;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Status = null;
            Error = $"Agent process is running but its local API is unavailable: {ex.Message}";
        }
    }

    private void ClearAgentData()
    {
        Status = null;
        Approvals = [];
        Secrets = [];
        ShellSessions = [];
        Audit = [];
        ClearSelectedShell();
    }

    private void ReconcileSelectedShell()
    {
        if (SelectedSessionId is null) return;
        if (ShellSessions.Any(x => string.Equals(x.SessionId, SelectedSessionId, StringComparison.Ordinal))) return;
        ClearSelectedShell();
    }

    private void ClearSelectedShell()
    {
        SelectedSessionId = null;
        ShellOffset = 0;
        ShellOutput = string.Empty;
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(async () => { await RefreshDynamicAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private Task StartAgentAsync() => ChangeAgentStateAsync("Starting Agent…", "Agent started.", AgentProcess.StartAsync);
    private Task StopAgentAsync() => ChangeAgentStateAsync("Stopping Agent…", "Agent stopped.", AgentProcess.StopAsync);
    private Task RestartAgentAsync() => ChangeAgentStateAsync("Restarting Agent…", "Agent restarted.", AgentProcess.RestartAsync);

    private async Task ChangeAgentStateAsync(string progress, string completed, Func<CancellationToken, Task> action)
    {
        if (LifecycleBusy) return;
        LifecycleBusy = true;
        LifecycleMessage = progress;
        Error = null;
        try
        {
            await action(_disposeCts.Token);
            await Task.Delay(500, _disposeCts.Token);
            await RefreshAllAsync();
            LifecycleMessage = completed;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Error = $"Could not change Agent state: {ex.Message}";
            AgentRunning = AgentProcess.IsRunning();
            LifecycleMessage = null;
        }
        finally
        {
            LifecycleBusy = false;
        }
    }

    private async Task CopyDeviceMcpUrlAsync()
    {
        if (DeviceMcpUrl is null) return;
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(DeviceMcpUrl);
        DeviceUrlCopied = true;
    }

    private async Task DecideAsync(string id, string decision)
    {
        await Api.DecideApprovalAsync(id, decision, _disposeCts.Token);
        Approvals = await Api.GetApprovalsAsync(_disposeCts.Token);
        Audit = await Api.GetAuditAsync(250, _disposeCts.Token);
    }

    private async Task SelectShellAsync(string id)
    {
        SelectedSessionId = id;
        ShellOffset = 0;
        ShellOutput = string.Empty;
        var snapshot = await Api.ReadShellSessionAsync(id, 0, _disposeCts.Token);
        if (snapshot is null) return;
        ShellOutput = snapshot.Output;
        ShellOffset = snapshot.NextOffset;
    }

    private async Task SendShellInputAsync()
    {
        if (SelectedSessionId is null || string.IsNullOrEmpty(ShellInput)) return;
        var input = ShellInput;
        ShellInput = string.Empty;
        await Api.SendShellInputAsync(SelectedSessionId, input, true, _disposeCts.Token);
    }

    private async Task HandleShellKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendShellInputAsync();
    }

    private async Task CloseSelectedShellAsync()
    {
        if (SelectedSessionId is null) return;
        await Api.CloseShellSessionAsync(SelectedSessionId, _disposeCts.Token);
        ClearSelectedShell();
        ShellSessions = await Api.GetShellSessionsAsync(_disposeCts.Token);
    }

    private async Task SaveSecretAsync()
    {
        if (string.IsNullOrWhiteSpace(SecretName) || string.IsNullOrEmpty(SecretValue)) return;
        var allowed = SecretAllowedTools.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        await Api.SaveSecretAsync(SecretName.Trim(), SecretValue, string.IsNullOrWhiteSpace(SecretDescription) ? null : SecretDescription.Trim(), allowed, _disposeCts.Token);
        SecretValue = string.Empty;
        Secrets = await Api.GetSecretsAsync(_disposeCts.Token);
        Audit = await Api.GetAuditAsync(250, _disposeCts.Token);
    }

    private async Task DeleteSecretAsync(string name)
    {
        await Api.DeleteSecretAsync(name, _disposeCts.Token);
        Secrets = await Api.GetSecretsAsync(_disposeCts.Token);
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch (OperationCanceledException) { }
        }
        _disposeCts.Dispose();
    }
}
