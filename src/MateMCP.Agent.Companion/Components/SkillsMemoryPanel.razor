@inject AgentApiClient Api
@inject ILogger<SkillsMemoryPanel> Logger
@inject IJSRuntime JS

<div class="panel" style="margin-bottom:12px">
    <strong>Global Skills & Memory</strong>
    <div class="muted" style="margin-top:6px">
        This store is global only. Project-specific knowledge belongs in the repository as <code>SKILL.md</code> files,
        preferably under <code>.matemcp/skills/&lt;name&gt;/SKILL.md</code>, so it travels with Git when work moves to another MateMCP Agent.
    </div>
</div>

<dialog id="skills-memory-editor" class="companion-dialog skills-memory-dialog" aria-labelledby="skills-memory-editor-title">
    <div class="companion-dialog-surface">
        <div class="companion-dialog-header">
            <strong id="skills-memory-editor-title">@(EditingId is null ? "Add global Skills / Memory item" : "Edit global Skills / Memory item")</strong>
            <button type="button" class="companion-dialog-close" aria-label="Close editor" @onclick="CancelDialogAsync">×</button>
        </div>

        <div class="companion-dialog-body">
            <div class="field"><label for="memory-title">Title</label><input id="memory-title" autofocus @bind="Title" /></div>
            <div class="field"><label for="memory-type">Type</label><select id="memory-type" @bind="Type"><option value="memory">Memory</option><option value="skill">Skill</option><option value="rule">Rule</option><option value="procedure">Procedure</option></select></div>
            <div class="field"><label for="memory-tags">Tags (comma separated)</label><input id="memory-tags" @bind="Tags" /></div>
            <div class="field"><label for="memory-description">Description</label><input id="memory-description" @bind="Description" /></div>
            <div class="field"><label for="memory-content">Content (Markdown)</label><textarea id="memory-content" rows="12" @bind="Content"></textarea></div>
            <label><input type="checkbox" @bind="Enabled" /> Enabled</label>

            <div class="actions" style="margin-top:12px">
                <Button Text="Save" OnClick="SaveAsync" />
                <Button Text="Cancel" OnClick="CancelDialogAsync" />
            </div>

            <div class="muted" style="margin-top:10px">Use this only for durable cross-project knowledge. Never store credentials here; use Secret Manager.</div>
            @if (!string.IsNullOrWhiteSpace(EditorErrorMessage))
            {
                <div class="error" role="alert" aria-live="polite" style="margin-top:8px">@EditorErrorMessage</div>
            }
        </div>
    </div>
</dialog>

<div class="panel">
    <div class="toolbar memory-toolbar">
        <div>
            <strong>Stored global Skills & Memory</strong>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="muted" style="margin-top:6px" role="status">@Message</div>
            }
        </div>
        <Button Text="Add item" OnClick="OpenAddAsync" />
    </div>

    @if (!string.IsNullOrWhiteSpace(PageErrorMessage))
    {
        <div class="error" role="alert" aria-live="polite">@PageErrorMessage</div>
    }

    <div class="actions memory-filters">
        <select aria-label="Filter by type" @bind="FilterType" @bind:after="LoadAsync"><option value="">All types</option><option value="memory">Memory</option><option value="skill">Skill</option><option value="rule">Rule</option><option value="procedure">Procedure</option></select>
        <select aria-label="Filter by archive state" @bind="FilterArchived"><option value="active">Active</option><option value="archived">Archived</option><option value="all">All states</option></select>
        <select aria-label="Sort items" @bind="SortBy"><option value="updated-desc">Recently updated</option><option value="updated-asc">Oldest updated</option><option value="title">Title</option><option value="created-desc">Recently created</option></select>
        <input @bind="FilterText" placeholder="Search" aria-label="Search Skills and Memory" />
        <Button Text="Search" OnClick="LoadAsync" />
    </div>

    @if (IsLoading)
    {
        <div class="muted" style="margin-top:12px">Loading…</div>
    }
    else if (!VisibleItems.Any())
    {
        <div class="muted" style="margin-top:12px">No matching items. Use Add item to create one.</div>
    }

    @foreach (var item in VisibleItems)
    {
        <div class="row" @key="item.Id">
            <strong>@item.Title</strong>
            <div class="muted">@item.Type · global · source: @item.Source · last modified by: @item.UpdatedBy · @(item.Archived ? "archived" : item.Enabled ? "enabled" : "disabled")</div>
            <div class="muted">Created @FormatTime(item.CreatedAt) · Updated @FormatTime(item.UpdatedAt)</div>
            @if (item.Tags is { Count: > 0 }) { <div class="muted">@string.Join(", ", item.Tags)</div> }
            @if (!string.IsNullOrWhiteSpace(item.Description)) { <div>@item.Description</div> }
            <div style="white-space:pre-wrap">@item.Content</div>
            <div class="actions">
                <Button Text="Edit" OnClick="() => OpenEditAsync(item)" />
                <Button Text="@(item.Enabled ? "Disable" : "Enable")" OnClick="() => ToggleEnabledAsync(item)" />
                <Button Text="@(item.Archived ? "Unarchive" : "Archive")" OnClick="() => ToggleArchiveAsync(item)" />
                <Button Text="Delete" OnClick="() => DeleteAsync(item)" />
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<SkillMemoryItem> Items { get; set; } = [];
    private string? EditingId { get; set; }
    private string Title { get; set; } = "";
    private string Type { get; set; } = "memory";
    private string Tags { get; set; } = "";
    private string Description { get; set; } = "";
    private string Content { get; set; } = "";
    private bool Enabled { get; set; } = true;
    private bool Archived { get; set; }
    private string FilterType { get; set; } = "";
    private string FilterArchived { get; set; } = "active";
    private string SortBy { get; set; } = "updated-desc";
    private string FilterText { get; set; } = "";
    private string? Message { get; set; }
    private string? PageErrorMessage { get; set; }
    private string? EditorErrorMessage { get; set; }
    private bool IsLoading { get; set; }

    private IEnumerable<SkillMemoryItem> VisibleItems
    {
        get
        {
            IEnumerable<SkillMemoryItem> query = Items;
            query = FilterArchived switch
            {
                "archived" => query.Where(x => x.Archived),
                "all" => query,
                _ => query.Where(x => !x.Archived)
            };
            return SortBy switch
            {
                "updated-asc" => query.OrderBy(x => x.UpdatedAt),
                "title" => query.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase),
                "created-desc" => query.OrderByDescending(x => x.CreatedAt),
                _ => query.OrderByDescending(x => x.UpdatedAt)
            };
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        PageErrorMessage = null;
        try
        {
            Items = await Api.GetSkillMemoryAsync(
                scope: "global",
                type: string.IsNullOrWhiteSpace(FilterType) ? null : FilterType,
                text: string.IsNullOrWhiteSpace(FilterText) ? null : FilterText);
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            Items = [];
            PageErrorMessage = BuildApiErrorMessage(ex, "load");
            Logger.LogError(ex, "Failed to load global Skills & Memory from the local Agent API.");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenAddAsync()
    {
        ResetEditor();
        Message = null;
        EditorErrorMessage = null;
        await JS.InvokeVoidAsync("mateMcpModal.open", "skills-memory-editor", "#memory-title");
    }

    private async Task OpenEditAsync(SkillMemoryItem item)
    {
        EditingId = item.Id;
        Title = item.Title;
        Type = item.Type;
        Tags = string.Join(", ", item.Tags ?? []);
        Description = item.Description ?? "";
        Content = item.Content;
        Enabled = item.Enabled;
        Archived = item.Archived;
        Message = null;
        EditorErrorMessage = null;
        await JS.InvokeVoidAsync("mateMcpModal.open", "skills-memory-editor", "#memory-title");
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(Content))
        {
            EditorErrorMessage = "Title and Content are required.";
            return;
        }

        EditorErrorMessage = null;
        try
        {
            var tags = Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            var edit = new SkillMemoryEdit(Title.Trim(), Type, "global", null, tags,
                string.IsNullOrWhiteSpace(Description) ? null : Description.Trim(), Content, "user", Enabled, Archived);
            var wasCreating = EditingId is null;
            await Api.SaveSkillMemoryAsync(EditingId, edit);
            ResetEditor();
            Message = wasCreating ? "Item created." : "Item updated.";
            await LoadAsync();
            await CloseEditorAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            EditorErrorMessage = BuildApiErrorMessage(ex, "save");
            Logger.LogError(ex, "Failed to save global Skills & Memory item through the local Agent API.");
        }
    }

    private async Task CancelDialogAsync()
    {
        ResetEditor();
        EditorErrorMessage = null;
        await CloseEditorAsync();
    }

    private async Task CloseEditorAsync()
        => await JS.InvokeVoidAsync("mateMcpModal.close", "skills-memory-editor");

    private async Task ToggleEnabledAsync(SkillMemoryItem item)
        => await UpdateStateAsync(item, !item.Enabled, item.Archived, item.Enabled ? "Item disabled." : "Item enabled.");

    private async Task ToggleArchiveAsync(SkillMemoryItem item)
        => await UpdateStateAsync(item, item.Enabled, !item.Archived, item.Archived ? "Item unarchived." : "Item archived.");

    private async Task UpdateStateAsync(SkillMemoryItem item, bool enabled, bool archived, string message)
    {
        PageErrorMessage = null;
        try
        {
            var edit = new SkillMemoryEdit(item.Title, item.Type, "global", null, item.Tags, item.Description, item.Content, "user", enabled, archived);
            await Api.SaveSkillMemoryAsync(item.Id, edit);
            Message = message;
            await LoadAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            PageErrorMessage = BuildApiErrorMessage(ex, "update");
            Logger.LogError(ex, "Failed to update global Skills & Memory item {SkillMemoryId} state.", item.Id);
        }
    }

    private static string FormatTime(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private void ResetEditor()
    {
        EditingId = null;
        Title = "";
        Type = "memory";
        Tags = "";
        Description = "";
        Content = "";
        Enabled = true;
        Archived = false;
    }

    private async Task DeleteAsync(SkillMemoryItem item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete '{item.Title}' permanently? This cannot be undone.")) return;

        PageErrorMessage = null;
        try
        {
            await Api.DeleteSkillMemoryAsync(item.Id);
            Message = "Item deleted.";
            await LoadAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            PageErrorMessage = BuildApiErrorMessage(ex, "delete");
            Logger.LogError(ex, "Failed to delete global Skills & Memory item {SkillMemoryId} through the local Agent API.", item.Id);
        }
    }

    private static bool IsRecoverableApiFailure(Exception ex)
        => ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException;

    private static string BuildApiErrorMessage(Exception ex, string operation)
    {
        if (ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.NotFound })
            return "Skills & Memory is not available in the running Agent. Update/restart the Agent so it matches this Companion version.";

        if (ex is TaskCanceledException)
            return $"Could not {operation} Skills & Memory because the local Agent did not respond in time.";

        if (ex is System.Text.Json.JsonException or NotSupportedException)
            return "The running Agent returned an incompatible Skills & Memory response. Update/restart the Agent so it matches this Companion version.";

        return $"Could not {operation} Skills & Memory from the local Agent. Check that the Agent is running, then try again.";
    }
}
