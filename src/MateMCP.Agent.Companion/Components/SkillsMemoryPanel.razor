@inject AgentApiClient Api
@inject ILogger<SkillsMemoryPanel> Logger

<div class="grid">
    <div class="panel">
        <strong>@(EditingId is null ? "Add Skills / Memory item" : "Edit Skills / Memory item")</strong>
        <div class="field"><label>Title</label><input @bind="Title" /></div>
        <div class="field"><label>Type</label><select @bind="Type"><option value="memory">Memory</option><option value="skill">Skill</option><option value="rule">Rule</option><option value="procedure">Procedure</option></select></div>
        <div class="field"><label>Scope</label><select @bind="Scope"><option value="global">Global</option><option value="project">Project</option></select></div>
        @if (Scope == "project")
        {
            <div class="field">
                <label>Project</label>
                <select @bind="Project">
                    <option value="">Select a registered project</option>
                    @foreach (var project in Projects.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@project.Id">@project.Name@(project.Available ? "" : " (missing)")</option>
                    }
                </select>
            </div>
        }
        <div class="field"><label>Tags (comma separated)</label><input @bind="Tags" /></div>
        <div class="field"><label>Description</label><input @bind="Description" /></div>
        <div class="field"><label>Content (Markdown)</label><textarea rows="12" @bind="Content"></textarea></div>
        <label><input type="checkbox" @bind="Enabled" /> Enabled</label>
        <div class="actions" style="margin-top:12px">
            <Button Text="Save" OnClick="SaveAsync" />
            @if (EditingId is not null) { <Button Text="Cancel" OnClick="CancelEdit" /> }
        </div>
        <div class="muted" style="margin-top:10px">Project-scoped items are bound to the selected registered project's stable ID. Unregistering a project does not delete these items. Never store credentials here; use Secret Manager.</div>
        @if (!string.IsNullOrWhiteSpace(Message)) { <div class="muted" style="margin-top:8px">@Message</div> }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="error" style="margin-top:8px">@ErrorMessage</div>
        }
    </div>

    <div class="panel">
        <strong>Stored Skills & Memory</strong>
        <div class="actions" style="margin-top:10px">
            <select @bind="FilterScope" @bind:after="LoadAsync"><option value="">All scopes</option><option value="global">Global</option><option value="project">Project</option></select>
            <select @bind="FilterProject" @bind:after="LoadAsync">
                <option value="">All projects</option>
                @foreach (var project in Projects.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
            <select @bind="FilterType" @bind:after="LoadAsync"><option value="">All types</option><option value="memory">Memory</option><option value="skill">Skill</option><option value="rule">Rule</option><option value="procedure">Procedure</option></select>
            <input @bind="FilterText" placeholder="Search" />
            <Button Text="Search" OnClick="LoadAsync" />
        </div>
        @if (IsLoading)
        {
            <div class="muted" style="margin-top:12px">Loading…</div>
        }
        else if (Items.Count == 0)
        {
            <div class="muted" style="margin-top:12px">No matching items.</div>
        }
        @foreach (var item in Items)
        {
            <div class="row" @key="item.Id">
                <strong>@item.Title</strong>
                <div class="muted">@item.Type · @item.Scope@(item.Project is null ? "" : $":{ProjectLabel(item.Project)}") · created by: @item.Source · updated by: @item.UpdatedBy · @(item.Enabled ? "enabled" : "disabled")</div>
                @if (item.Tags is { Count: > 0 }) { <div class="muted">@string.Join(", ", item.Tags)</div> }
                @if (!string.IsNullOrWhiteSpace(item.Description)) { <div>@item.Description</div> }
                <div style="white-space:pre-wrap">@item.Content</div>
                <div class="actions"><Button Text="Edit" OnClick="() => Edit(item)" /><Button Text="Delete" OnClick="() => DeleteAsync(item.Id)" /></div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? ProjectContext { get; set; }

    private IReadOnlyList<SkillMemoryItem> Items { get; set; } = [];
    private IReadOnlyList<CompanionProjectInfo> Projects { get; set; } = [];
    private string? EditingId { get; set; }
    private string Title { get; set; } = "";
    private string Type { get; set; } = "memory";
    private string Scope { get; set; } = "global";
    private string Project { get; set; } = "";
    private string Tags { get; set; } = "";
    private string Description { get; set; } = "";
    private string Content { get; set; } = "";
    private bool Enabled { get; set; } = true;
    private string FilterScope { get; set; } = "";
    private string FilterProject { get; set; } = "";
    private string FilterType { get; set; } = "";
    private string FilterText { get; set; } = "";
    private string? Message { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private bool Initialized { get; set; }
    private string? AppliedProjectContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
        ApplyProjectContext();
        await LoadAsync();
        Initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Initialized || string.Equals(ProjectContext, AppliedProjectContext, StringComparison.OrdinalIgnoreCase)) return;
        ApplyProjectContext();
        await LoadAsync();
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            Projects = await Api.GetProjectsAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            Projects = [];
            ErrorMessage = $"Could not load registered projects: {ex.Message}";
            Logger.LogError(ex, "Failed to load Projects for Skills & Memory.");
        }
    }

    private void ApplyProjectContext()
    {
        AppliedProjectContext = ProjectContext;
        if (string.IsNullOrWhiteSpace(ProjectContext)) return;
        var resolved = ResolveProjectReference(ProjectContext);
        Scope = "project";
        Project = resolved;
        FilterScope = "project";
        FilterProject = resolved;
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Items = await Api.GetSkillMemoryAsync(
                string.IsNullOrWhiteSpace(FilterScope) ? null : FilterScope,
                project: string.IsNullOrWhiteSpace(FilterProject) ? null : FilterProject,
                type: string.IsNullOrWhiteSpace(FilterType) ? null : FilterType,
                text: string.IsNullOrWhiteSpace(FilterText) ? null : FilterText);
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            Items = [];
            ErrorMessage = BuildApiErrorMessage(ex, "load");
            Logger.LogError(ex, "Failed to load Skills & Memory from the local Agent API.");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(Content)) return;
        if (Scope == "project" && string.IsNullOrWhiteSpace(Project))
        {
            ErrorMessage = "Select a registered project for project-scoped Skills & Memory.";
            return;
        }

        ErrorMessage = null;
        try
        {
            var tags = Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            var edit = new SkillMemoryEdit(Title.Trim(), Type, Scope, Scope == "project" ? Project : null, tags,
                string.IsNullOrWhiteSpace(Description) ? null : Description.Trim(), Content, "user", Enabled);
            var wasCreating = EditingId is null;
            await Api.SaveSkillMemoryAsync(EditingId, edit);
            CancelEdit();
            Message = wasCreating ? "Item created." : "Item updated.";
            await LoadAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            ErrorMessage = BuildApiErrorMessage(ex, "save");
            Logger.LogError(ex, "Failed to save Skills & Memory item through the local Agent API.");
        }
    }

    private void Edit(SkillMemoryItem item)
    {
        EditingId = item.Id; Title = item.Title; Type = item.Type; Scope = item.Scope; Project = ResolveProjectReference(item.Project);
        Tags = string.Join(", ", item.Tags ?? []); Description = item.Description ?? ""; Content = item.Content; Enabled = item.Enabled; Message = null; ErrorMessage = null;
    }

    private string ResolveProjectReference(string? reference)
    {
        if (string.IsNullOrWhiteSpace(reference)) return "";
        var project = Projects.FirstOrDefault(x => string.Equals(x.Id, reference, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.Name, reference, StringComparison.OrdinalIgnoreCase));
        return project?.Id ?? reference;
    }

    private string ProjectLabel(string reference)
    {
        var project = Projects.FirstOrDefault(x => string.Equals(x.Id, reference, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.Name, reference, StringComparison.OrdinalIgnoreCase));
        return project?.Name ?? reference;
    }

    private void CancelEdit()
    {
        EditingId = null; Title = ""; Type = "memory"; Scope = "global"; Project = ""; Tags = ""; Description = ""; Content = ""; Enabled = true;
        if (!string.IsNullOrWhiteSpace(ProjectContext))
        {
            Scope = "project";
            Project = ResolveProjectReference(ProjectContext);
        }
    }

    private async Task DeleteAsync(string id)
    {
        ErrorMessage = null;
        try
        {
            await Api.DeleteSkillMemoryAsync(id);
            if (EditingId == id) CancelEdit();
            Message = "Item deleted.";
            await LoadAsync();
        }
        catch (Exception ex) when (IsRecoverableApiFailure(ex))
        {
            ErrorMessage = BuildApiErrorMessage(ex, "delete");
            Logger.LogError(ex, "Failed to delete Skills & Memory item {SkillMemoryId} through the local Agent API.", id);
        }
    }

    private static bool IsRecoverableApiFailure(Exception ex)
        => ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException;

    private static string BuildApiErrorMessage(Exception ex, string operation)
    {
        if (ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.NotFound })
            return "Skills & Memory is not available in the running Agent. Update/restart the Agent so it matches this Companion version.";

        if (ex is TaskCanceledException)
            return $"Could not {operation} Skills & Memory because the local Agent did not respond in time.";

        if (ex is System.Text.Json.JsonException or NotSupportedException)
            return "The running Agent returned an incompatible Skills & Memory response. Update/restart the Agent so it matches this Companion version.";

        return $"Could not {operation} Skills & Memory from the local Agent. Check that the Agent is running, then try again.";
    }
}
