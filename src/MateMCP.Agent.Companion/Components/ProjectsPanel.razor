@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json

<div class="panel">
    <div class="toolbar">
        <div>
            <strong>Projects</strong>
            <div class="muted">Register and manage local workspaces. Removing a project never deletes its files.</div>
        </div>
        <div class="actions">
            <input @bind="Search" @bind:event="oninput" placeholder="Search projects" aria-label="Search projects" />
            <Button Text="Add Project" OnClick="BeginAdd" />
            <Button Text="Refresh" OnClick="LoadAsync" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="error" style="margin-top:12px">@Error</div>
    }

    @if (Editing)
    {
        <div class="panel" style="margin-top:12px">
            <strong>@(EditingOriginalName is null ? "Add Project" : "Edit Project")</strong>
            <div class="field"><label>Name</label><input @bind="EditName" /></div>
            <div class="field"><label>Workspace path</label><input @bind="EditRoot" placeholder="/path/to/project or C:\projects\project" /></div>
            <div class="actions">
                <label><input type="checkbox" @bind="EditRead" /> Read</label>
                <label><input type="checkbox" @bind="EditWrite" /> Write</label>
                <label><input type="checkbox" @bind="EditShell" /> Shell</label>
            </div>
            <div class="actions" style="margin-top:12px">
                <Button Text="Save" OnClick="SaveAsync" />
                <Button Text="Cancel" OnClick="CancelEdit" />
            </div>
        </div>
    }

    @if (Loading)
    {
        <div class="muted" style="margin-top:12px">Loading projects…</div>
    }
    else if (FilteredProjects.Count == 0)
    {
        <div class="muted" style="margin-top:12px">No projects match the current filter.</div>
    }
    else
    {
        <div class="list" style="margin-top:12px">
            @foreach (var project in FilteredProjects)
            {
                <div class="row" @key="project.Id">
                    <div class="actions" style="justify-content:space-between">
                        <strong>@project.Name</strong>
                        <Badge Text="@(project.Available ? "Available" : "Missing")" />
                    </div>
                    <div>@project.Root</div>
                    <div class="muted">ID: @project.Id · Read: @YesNo(project.Read) · Write: @YesNo(project.Write) · Shell: @YesNo(project.Shell)</div>
                    <div class="actions">
                        <Button Text="Skills & Memory" OnClick="() => OpenSkillsMemory.InvokeAsync(project.Id)" />
                        <Button Text="Edit" OnClick="() => BeginEdit(project)" />
                        @if (ConfirmRemoveName == project.Name)
                        {
                            <span class="muted">Unregister only; source files and associated Skills & Memory will not be deleted.</span>
                            <Button Text="Confirm unregister" OnClick="() => RemoveAsync(project.Name)" />
                            <Button Text="Cancel" OnClick="() => ConfirmRemoveName = null" />
                        }
                        else
                        {
                            <Button Text="Unregister" OnClick="() => ConfirmRemoveName = project.Name" />
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OpenSkillsMemory { get; set; }

    private readonly HttpClient _http;
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<ProjectInfo> Projects { get; set; } = [];
    private bool Loading { get; set; }
    private bool Editing { get; set; }
    private string? EditingOriginalName { get; set; }
    private string? ConfirmRemoveName { get; set; }
    private string Search { get; set; } = string.Empty;
    private string EditName { get; set; } = string.Empty;
    private string EditRoot { get; set; } = string.Empty;
    private bool EditRead { get; set; } = true;
    private bool EditWrite { get; set; } = true;
    private bool EditShell { get; set; } = true;
    private string? Error { get; set; }

    public ProjectsPanel()
    {
        var configured = Environment.GetEnvironmentVariable("MATEMCP_COMPANION_AGENT_URL");
        var baseUrl = string.IsNullOrWhiteSpace(configured) ? "http://127.0.0.1:45871/" : configured.TrimEnd('/') + "/";
        _http = new HttpClient { BaseAddress = new Uri(baseUrl), Timeout = TimeSpan.FromSeconds(10) };
    }

    private IReadOnlyList<ProjectInfo> FilteredProjects => Projects
        .Where(p => string.IsNullOrWhiteSpace(Search)
                    || p.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)
                    || p.Root.Contains(Search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Projects = await _http.GetFromJsonAsync<List<ProjectInfo>>("projects", Json) ?? [];
        }
        catch (Exception ex)
        {
            Error = $"Could not load projects: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private void BeginAdd()
    {
        Editing = true;
        EditingOriginalName = null;
        EditName = string.Empty;
        EditRoot = string.Empty;
        EditRead = EditWrite = EditShell = true;
        Error = null;
    }

    private void BeginEdit(ProjectInfo project)
    {
        Editing = true;
        EditingOriginalName = project.Name;
        EditName = project.Name;
        EditRoot = project.Root;
        EditRead = project.Read;
        EditWrite = project.Write;
        EditShell = project.Shell;
        Error = null;
    }

    private void CancelEdit()
    {
        Editing = false;
        EditingOriginalName = null;
        Error = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(EditName) || string.IsNullOrWhiteSpace(EditRoot))
        {
            Error = "Project name and workspace path are required.";
            return;
        }

        Error = null;
        try
        {
            var update = new ProjectEdit(EditName.Trim(), EditRoot.Trim(), EditRead, EditWrite, EditShell);
            using var response = EditingOriginalName is null
                ? await _http.PostAsJsonAsync("projects", update, Json)
                : await _http.PutAsJsonAsync($"projects/{Uri.EscapeDataString(EditingOriginalName)}", update, Json);
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadProblemAsync(response);
                return;
            }

            Editing = false;
            EditingOriginalName = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = $"Could not save project: {ex.Message}";
        }
    }

    private async Task RemoveAsync(string name)
    {
        Error = null;
        try
        {
            using var response = await _http.DeleteAsync($"projects/{Uri.EscapeDataString(name)}");
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadProblemAsync(response);
                return;
            }
            ConfirmRemoveName = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = $"Could not unregister project: {ex.Message}";
        }
    }

    private static async Task<string> ReadProblemAsync(HttpResponseMessage response)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<Problem>(Json);
            if (!string.IsNullOrWhiteSpace(problem?.Detail)) return problem.Detail;
            if (!string.IsNullOrWhiteSpace(problem?.Title)) return problem.Title;
        }
        catch { }
        return $"Agent returned {(int)response.StatusCode} {response.ReasonPhrase}.";
    }

    private static string YesNo(bool value) => value ? "Yes" : "No";
    public void Dispose() => _http.Dispose();

    private sealed record ProjectInfo(string Id, string Name, string Root, bool Read, bool Write, bool Shell, bool Available);
    private sealed record ProjectEdit(string Name, string Root, bool Read, bool Write, bool Shell);
    private sealed record Problem(string? Title, string? Detail);
}
