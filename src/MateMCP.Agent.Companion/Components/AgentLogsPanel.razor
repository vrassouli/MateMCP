@implements IAsyncDisposable
@inject AgentApiClient Api

<div class="panel">
    <div class="toolbar" style="align-items:flex-end;gap:12px;flex-wrap:wrap;">
        <div class="field" style="min-width:220px;flex:1;">
            <label>Search</label>
            <input @bind="SearchText" @bind:event="oninput" placeholder="Capability, target, result, credential, tool..." />
        </div>
        <div class="field" style="min-width:160px;">
            <label>Level</label>
            <select @bind="LevelFilter">
                <option value="All">All</option>
                <option value="Information">Information</option>
                <option value="Warning">Warning</option>
                <option value="Error">Error</option>
            </select>
        </div>
        <div class="actions">
            <Button Text="Refresh" OnClick="RefreshAsync" />
            <Button Text="@(Following ? "Pause follow" : "Resume follow")" OnClick="ToggleFollow" />
            <Button Text="Copy diagnostics" OnClick="CopyDiagnosticsAsync" />
            <Button Text="Clear view" OnClick="ClearView" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="muted" style="margin:10px 0">@Message</div>
    }

    <div style="margin-top:12px;max-height:70vh;overflow:auto;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;line-height:1.5;">
        @if (VisibleEntries.Count == 0)
        {
            <div class="muted">No matching diagnostic entries.</div>
        }
        else
        {
            @foreach (var entry in VisibleEntries)
            {
                var level = Classify(entry);
                <div style="padding:7px 0;border-bottom:1px solid rgba(127,127,127,.18);" @key="entry.Timestamp.ToUnixTimeMilliseconds().ToString() + entry.Capability + entry.Target">
                    <div><strong>@entry.Timestamp.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</strong> <span>[@level]</span> <span>@entry.Capability</span></div>
                    <div>@entry.Target</div>
                    <div class="muted">@entry.Result@if (!string.IsNullOrWhiteSpace(entry.Tool)) { <text> · tool: @entry.Tool</text> }@if (!string.IsNullOrWhiteSpace(entry.Credential)) { <text> · credential: @entry.Credential</text> }</div>
                </div>
            }
        }
    </div>
</div>

@code {
    private readonly CancellationTokenSource _disposeCts = new();
    private Task? _pollTask;
    private IReadOnlyList<AuditEntry> Entries { get; set; } = [];
    private string SearchText { get; set; } = string.Empty;
    private string LevelFilter { get; set; } = "All";
    private bool Following { get; set; } = true;
    private string? Message { get; set; }

    private IReadOnlyList<AuditEntry> VisibleEntries => Entries
        .Where(MatchesLevel)
        .Where(MatchesSearch)
        .OrderByDescending(x => x.Timestamp)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _pollTask = PollAsync(_disposeCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!Following) continue;
                await RefreshAsync(ct);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync() => await RefreshAsync(_disposeCts.Token);

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            Entries = await Api.GetAuditAsync(500, DateTimeOffset.UtcNow.AddDays(-2), DateTimeOffset.UtcNow.AddMinutes(1), ct);
            Message = Following ? $"Live follow is on · {Entries.Count} recent structured entries" : $"Follow paused · {Entries.Count} entries loaded";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Message = $"Diagnostics unavailable: {ex.Message}";
        }
    }

    private bool MatchesSearch(AuditEntry entry)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var needle = SearchText.Trim();
        return Contains(entry.Capability, needle) || Contains(entry.Target, needle) || Contains(entry.Result, needle) ||
               Contains(entry.Credential, needle) || Contains(entry.Tool, needle);
    }

    private bool MatchesLevel(AuditEntry entry)
        => LevelFilter == "All" || string.Equals(Classify(entry), LevelFilter, StringComparison.OrdinalIgnoreCase);

    private static string Classify(AuditEntry entry)
    {
        var result = entry.Result ?? string.Empty;
        if (result.Contains("error", StringComparison.OrdinalIgnoreCase) ||
            result.Contains("fail", StringComparison.OrdinalIgnoreCase) ||
            result.Contains("exception", StringComparison.OrdinalIgnoreCase)) return "Error";
        if (result.Contains("deny", StringComparison.OrdinalIgnoreCase) ||
            result.Contains("reject", StringComparison.OrdinalIgnoreCase) ||
            result.Contains("not-found", StringComparison.OrdinalIgnoreCase)) return "Warning";
        return "Information";
    }

    private static bool Contains(string? value, string needle)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(needle, StringComparison.OrdinalIgnoreCase);

    private void ToggleFollow()
    {
        Following = !Following;
        Message = Following ? "Live follow resumed." : "Live follow paused.";
    }

    private void ClearView()
    {
        Entries = [];
        Following = false;
        Message = "View cleared. Resume follow or refresh to load entries again.";
    }

    private async Task CopyDiagnosticsAsync()
    {
        var lines = VisibleEntries.Take(500).Select(entry =>
            $"{entry.Timestamp:O}\t{Classify(entry)}\t{entry.Capability}\t{entry.Target}\t{entry.Result}\ttool={entry.Tool ?? "-"}\tcredential={entry.Credential ?? "-"}");
        var text = "MateMCP Agent diagnostics\nGenerated: " + DateTimeOffset.Now.ToString("O") + "\n\n" + string.Join("\n", lines);
        await Clipboard.Default.SetTextAsync(text);
        Message = $"Copied {VisibleEntries.Take(500).Count()} diagnostic entries.";
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch (OperationCanceledException) { }
        }
        _disposeCts.Dispose();
    }
}
