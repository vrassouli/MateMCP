@implements IAsyncDisposable
@inject AgentApiClient Api

<div class="panel">
    <div class="toolbar log-toolbar">
        <div>
            <strong>Agent diagnostics</strong>
            <div class="muted">Recent structured Agent logs are retained locally with bounded history and sensitive-value redaction.</div>
        </div>
        <div class="actions">
            <label class="update-toggle"><input type="checkbox" @bind="Live" /> Live updates</label>
            <Button Text="Copy diagnostics" OnClick="CopyAsync" />
            @if (!ConfirmClear)
            {
                <Button Text="Clear" OnClick="() => ConfirmClear = true" />
            }
            else
            {
                <Button Text="Confirm clear" OnClick="ClearAsync" />
                <Button Text="Cancel" OnClick="() => ConfirmClear = false" />
            }
        </div>
    </div>

    <div class="log-filters">
        <div class="field">
            <label>Minimum level</label>
            <select @bind="Level" @bind:after="ReloadAsync">
                <option value="">Trace</option>
                <option value="Debug">Debug</option>
                <option value="Information">Information</option>
                <option value="Warning">Warning</option>
                <option value="Error">Error</option>
                <option value="Critical">Critical</option>
            </select>
        </div>
        <div class="field">
            <label>Search</label>
            <input @bind="Search" @onkeydown="HandleSearchKeyAsync" placeholder="Message or category" />
        </div>
        <div class="actions"><Button Text="Apply" OnClick="ReloadAsync" /></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="error">@Error</div>
    }

    <div class="terminal log-terminal" aria-live="polite" aria-label="Agent logs">
        @if (Entries.Count == 0)
        {
            <div class="log-empty">No matching Agent logs.</div>
        }
        @foreach (var entry in Entries)
        {
            <div class="log-entry" @key="entry.Id"><span class="log-time">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</span> <span class="log-level">@LevelName(entry.Level)</span> <span class="log-category">[@entry.Category]</span> @entry.Message</div>
        }
    </div>
    <div class="muted" style="margin-top:8px">Scrolling upward pauses automatic viewport following; return near the bottom to resume. Live updates can also be paused with the toggle.</div>
</div>

@code {
    private readonly CancellationTokenSource _disposeCts = new();
    private readonly List<AgentLogEntry> Entries = [];
    private Task? _pollTask;
    private long Cursor { get; set; }
    private string Level { get; set; } = "Information";
    private string Search { get; set; } = "";
    private bool Live { get; set; } = true;
    private bool ConfirmClear { get; set; }
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _pollTask = PollAsync(_disposeCts.Token);
    }

    private async Task ReloadAsync()
    {
        Entries.Clear();
        Cursor = 0;
        await LoadMoreAsync();
    }

    private async Task LoadMoreAsync()
    {
        try
        {
            var batch = await Api.GetAgentLogsAsync(Cursor, 500, string.IsNullOrWhiteSpace(Level) ? null : Level,
                string.IsNullOrWhiteSpace(Search) ? null : Search.Trim(), _disposeCts.Token);
            if (batch.Entries.Count > 0)
            {
                Entries.AddRange(batch.Entries);
                if (Entries.Count > 1000) Entries.RemoveRange(0, Entries.Count - 1000);
            }
            Cursor = batch.Cursor;
            Error = null;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex) { Error = $"Could not read Agent logs: {ex.Message}"; }
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!Live) continue;
                await InvokeAsync(async () => { await LoadMoreAsync(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task HandleSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAsync();
    }

    private async Task CopyAsync()
    {
        var text = string.Join(Environment.NewLine, Entries.Select(x => $"{x.Timestamp:O} {LevelName(x.Level),-11} [{x.Category}] {x.Message}"));
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
    }

    private async Task ClearAsync()
    {
        await Api.ClearAgentLogsAsync(_disposeCts.Token);
        ConfirmClear = false;
        Entries.Clear();
        Cursor = 0;
        await LoadMoreAsync();
    }

    private static string LevelName(int level) => level switch
    {
        0 => "Trace", 1 => "Debug", 2 => "Information", 3 => "Warning", 4 => "Error", 5 => "Critical", _ => "Unknown"
    };

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();
        if (_pollTask is not null) { try { await _pollTask; } catch (OperationCanceledException) { } }
        _disposeCts.Dispose();
    }
}
