@using Microsoft.AspNetCore.Components

<nav class="nav" aria-label="Companion navigation">
    <button class="@(ActiveSection == "dashboard" ? "active" : null)" @onclick='() => NavigateAsync("dashboard")'>
        <Icon Value="@FluentIcons.Home" />
        <span>Dashboard</span>
    </button>
    <button class="@(ActiveSection == "devices" ? "active" : null)" @onclick='() => NavigateAsync("devices")'>
        <Icon Value="@FluentIcons.Settings" />
        <span>Devices</span>
    </button>
    <button class="@(ActiveSection == "approvals" ? "active" : null)" @onclick='() => NavigateAsync("approvals")'>
        <Icon Value="@FluentIcons.Checkmark" />
        <span>Approvals</span>
        @if (ApprovalsCount > 0)
        {
            <Badge Text="@ApprovalsCount.ToString()" />
        }
    </button>
    <button class="@(ActiveSection == "shell" ? "active" : null)" @onclick='() => NavigateAsync("shell")'>
        <Icon Value="@FluentIcons.Code" />
        <span>Shell</span>
        @if (ActiveShellCount > 0)
        {
            <Badge Text="@ActiveShellCount.ToString()" />
        }
    </button>
    <button class="@(ActiveSection == "secrets" ? "active" : null)" @onclick='() => NavigateAsync("secrets")'>
        <Icon Value="@FluentIcons.Settings" />
        <span>Secrets</span>
    </button>
    <button class="@(ActiveSection == "projects" ? "active" : null)" @onclick='() => NavigateAsync("projects")'>
        <Icon Value="@FluentIcons.Document" />
        <span>Projects</span>
    </button>
    <button class="@(ActiveSection == "memory" ? "active" : null)" @onclick='() => NavigateAsync("memory")'>
        <Icon Value="@FluentIcons.Document" />
        <span>Global Skills &amp; Memory</span>
    </button>
    <button class="@(ActiveSection == "logs" ? "active" : null)" @onclick='() => NavigateAsync("logs")'>
        <Icon Value="@FluentIcons.Document" />
        <span>Agent Logs</span>
    </button>
    <button class="@(ActiveSection == "audit" ? "active" : null)" @onclick='() => NavigateAsync("audit")'>
        <Icon Value="@FluentIcons.Document" />
        <span>Activity</span>
    </button>
</nav>

@code {
    [Parameter] public string ActiveSection { get; set; } = "dashboard";
    [Parameter] public int ApprovalsCount { get; set; }
    [Parameter] public int ActiveShellCount { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private Task NavigateAsync(string section) => OnNavigate.InvokeAsync(section);
}
