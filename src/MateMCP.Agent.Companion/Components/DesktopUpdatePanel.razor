@implements IAsyncDisposable
@inject DesktopUpdateService Updates
@inject AgentApiClient Agent
@inject AgentCompatibilityService Compatibility
@inject AgentProcessController AgentProcess

<div class="panel">
    <strong>Desktop updates</strong>
    <div class="row">
        <span class="muted">Status</span>
        <div>@StatusText</div>
        @if (UpdateStatus?.UpdatedAt is { } updatedAt)
        {
            <div class="muted">Latest package: @updatedAt.LocalDateTime</div>
        }
    </div>
    @if (CompatibilityStatus is not null)
    {
        <div class="row">
            <span class="muted">Companion / Agent compatibility</span>
            <div>@CompatibilityStatus.Message</div>
            <div class="muted">Companion @CompatibilityStatus.CompanionVersion@if (!string.IsNullOrWhiteSpace(CompatibilityStatus.AgentVersion)) { <text> · Agent @CompatibilityStatus.AgentVersion</text> }@if (!string.IsNullOrWhiteSpace(CompatibilityStatus.CapabilityRevision)) { <text> · MCP revision @CompatibilityStatus.CapabilityRevision</text> }@if (CompatibilityStatus.ManagementApiRevision is { } apiRevision) { <text> · Management API @apiRevision</text> }</div>
            @if (!CompatibilityStatus.Compatible)
            {
                <div class="actions">
                    <Button Text="Restart Agent" OnClick="RestartAgentAsync" />
                    <Button Text="Check again" OnClick="CheckCompatibilityAsync" />
                </div>
            }
        </div>
    }
    @if (BackgroundUpdate is not null)
    {
        <div class="row">
            <span class="muted">Background updater</span>
            <div>@BackgroundUpdate.Message</div>
            @if (BackgroundUpdate.LastChangedAt is { } lastChanged)
            {
                <div class="muted">Last activity: @lastChanged.LocalDateTime</div>
            }
        </div>
    }
    @if (!Updating && !string.IsNullOrWhiteSpace(UpdateStatus?.LastFailure))
    {
        <div class="error">@UpdateStatus.LastFailure</div>
    }
    @if (!Updating && !string.IsNullOrWhiteSpace(BackgroundUpdate?.LastFailure))
    {
        <div class="error">@BackgroundUpdate.LastFailure</div>
    }
    <div class="row update-toggle-row">
        <label class="update-toggle">
            <input type="checkbox" checked="@AutoUpdateEnabled" @onchange="SetAutoUpdateAsync" disabled="@Updating" />
            <span>Automatically install new Desktop builds in the background</span>
        </label>
        <div class="muted">Auto Update is opt-in. The Agent checks and verifies official MateMCP Desktop packages even while Companion is closed, and defers installation while shell work or approvals are active.</div>
    </div>
    @if (Updating)
    {
        <div class="row update-progress-row" aria-live="polite">
            @if (UpdateProgress?.Percentage is { } percentage)
            {
                <progress class="update-progress-bar" max="100" value="@percentage"></progress>
                <div class="muted">@UpdateProgress.Message @percentage%</div>
            }
            else
            {
                <progress class="update-progress-bar" max="100"></progress>
                <div class="muted">@(UpdateProgress?.Message ?? "Preparing update...")</div>
            }
            <div class="muted">Companion will stay open while a manual package downloads and will close only when installation is ready to start. The desktop package updates both Companion and the local Agent, restarts the Agent, and verifies compatibility when Companion relaunches.</div>
        </div>
    }
    else
    {
        <div class="actions">
            <Button Text="Check for updates" OnClick="CheckNowAsync" />
            @if (UpdateStatus is { AssetId: { } assetId } && (UpdateStatus.UpdateAvailable || CompatibilityStatus is { Compatible: false }))
            {
                <Button Text="@(UpdateStatus.UpdateAvailable ? "Update now" : "Repair current package")" OnClick="() => BeginUpdateAsync(assetId)" />
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="error">@Error</div>
    }
</div>

<AgentPrivilegePanel />

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _worker;
    private DesktopUpdateStatus? UpdateStatus { get; set; }
    private DesktopBackgroundUpdateStatus? BackgroundUpdate { get; set; }
    private AgentCompatibilityStatus? CompatibilityStatus { get; set; }
    private DesktopUpdateProgress? UpdateProgress { get; set; }
    private string? Error { get; set; }
    private bool Checking { get; set; }
    private bool Updating { get; set; }
    private bool RestartingAgent { get; set; }
    private bool AutoUpdateEnabled { get; set; }

    private string StatusText => Updating
        ? UpdateProgress?.Message ?? "Preparing update..."
        : RestartingAgent
            ? "Restarting Agent and verifying compatibility..."
            : Checking
                ? "Checking..."
                : UpdateStatus?.Message ?? "Ready to check for updates.";

    protected override async Task OnInitializedAsync()
    {
        await CheckCompatibilityAsync();
        try
        {
            BackgroundUpdate = await Agent.GetDesktopUpdateStatusAsync(_cts.Token);
            AutoUpdateEnabled = BackgroundUpdate?.AutoUpdateEnabled ?? false;
        }
        catch (Exception ex)
        {
            Error = $"Could not read background updater status: {ex.Message}";
        }

        _worker = RunUpdateLoopAsync(_cts.Token);
    }

    private async Task CheckCompatibilityAsync()
    {
        CompatibilityStatus = await Compatibility.CheckAsync(_cts.Token);
    }

    private async Task RestartAgentAsync()
    {
        if (RestartingAgent || Updating) return;
        RestartingAgent = true;
        Error = null;
        try
        {
            await AgentProcess.RestartAsync(_cts.Token);
            await Task.Delay(750, _cts.Token);
            await CheckCompatibilityAsync();
            if (CompatibilityStatus is { Compatible: false })
                Error = "Agent restarted, but it is still incompatible with this Companion. Use Update now or repair/reinstall the current Desktop package.";
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Error = $"Could not restart Agent: {ex.Message}";
        }
        finally
        {
            RestartingAgent = false;
        }
    }

    private async Task CheckNowAsync()
    {
        if (Checking || Updating) return;
        Checking = true;
        Error = null;
        try
        {
            UpdateStatus = await Updates.CheckAsync(_cts.Token);
            BackgroundUpdate = await Agent.GetDesktopUpdateStatusAsync(_cts.Token);
            AutoUpdateEnabled = BackgroundUpdate?.AutoUpdateEnabled ?? AutoUpdateEnabled;
            await CheckCompatibilityAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Error = $"Update check failed: {ex.Message}";
        }
        finally
        {
            Checking = false;
        }
    }

    private async Task SetAutoUpdateAsync(ChangeEventArgs args)
    {
        var requested = args.Value is bool value && value;
        var previous = AutoUpdateEnabled;
        AutoUpdateEnabled = requested;
        Error = null;
        try
        {
            BackgroundUpdate = await Agent.SetDesktopAutoUpdateAsync(requested, _cts.Token);
            AutoUpdateEnabled = BackgroundUpdate?.AutoUpdateEnabled ?? requested;
        }
        catch (Exception ex)
        {
            AutoUpdateEnabled = previous;
            Error = $"Could not change Auto Update: {ex.Message}";
        }
    }

    private async Task BeginUpdateAsync(long assetId)
    {
        if (Updating) return;
        Updating = true;
        UpdateProgress = new DesktopUpdateProgress("Preparing", "Preparing coordinated Companion + Agent update...", 0, null);
        if (UpdateStatus is not null)
            UpdateStatus = UpdateStatus with { LastFailure = null };
        Error = null;
        StateHasChanged();

        var progress = new Progress<DesktopUpdateProgress>(value =>
        {
            UpdateProgress = value;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            await Updates.BeginUpdateAsync(assetId, progress, _cts.Token);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Error = $"Update failed before installation started: {ex.Message}. Companion is still running; check your network and try again.";
        }
        finally
        {
            Updating = false;
            UpdateProgress = null;
            StateHasChanged();
        }
    }

    private async Task RunUpdateLoopAsync(CancellationToken ct)
    {
        try
        {
            await InvokeAsync(async () => { await CheckNowAsync(); StateHasChanged(); });
            using var timer = new PeriodicTimer(TimeSpan.FromMinutes(30));
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(async () => { await CheckNowAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_worker is not null)
        {
            try { await _worker; } catch (OperationCanceledException) { }
        }
        _cts.Dispose();
    }
}
