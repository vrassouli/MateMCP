@implements IAsyncDisposable
@inject AgentApiClient Api

@if (Preview?.Active == true)
{
    <div class="@DockClass" aria-live="polite">
        <div class="computer-use-preview-heading">
            <div class="computer-use-preview-title-wrap">
                <div class="computer-use-live-line">
                    <span class="computer-use-live-dot" aria-hidden="true"></span>
                    <span>AI workspace · Live</span>
                </div>
                <strong title="@PreviewTitle">@PreviewTitle</strong>
            </div>
            <div class="computer-use-preview-heading-actions">
                @if (!string.IsNullOrWhiteSpace(Preview.LastAction))
                {
                    <span class="computer-use-action-pill">@Preview.LastAction</span>
                }
                <button type="button"
                        class="computer-use-preview-size-button"
                        @onclick="ToggleExpanded"
                        title="@(Expanded ? "Make preview compact" : "Expand preview")"
                        aria-label="@(Expanded ? "Make preview compact" : "Expand preview")">
                    @(Expanded ? "↙" : "↗")
                </button>
            </div>
        </div>

        <div class="computer-use-preview-frame" title="MateMCP virtual Computer Use cursor; your physical mouse is independent during semantic actions.">
            @if (!string.IsNullOrWhiteSpace(FrameDataUrl))
            {
                <img src="@FrameDataUrl" alt="Live preview of the window currently used by AI" />
            }
            else
            {
                <div class="computer-use-preview-placeholder">Waiting for the next window frame…</div>
            }

            @if (Preview.CursorX is { } cursorX && Preview.CursorY is { } cursorY)
            {
                <div class="computer-use-virtual-cursor"
                     style="--cursor-x:@(Percent(cursorX)); --cursor-y:@(Percent(cursorY));"
                     aria-label="AI cursor">
                    <span class="computer-use-cursor-arrow">➤</span>
                    <span class="computer-use-cursor-label">AI</span>
                </div>
            }
        </div>

        @if (Expanded)
        {
            <div class="computer-use-preview-footer">
                <span class="muted">@CaptureBackendLabel</span>
                <span class="muted">Your physical pointer stays independent for semantic actions.</span>
                @if (!string.IsNullOrWhiteSpace(Preview.CaptureError))
                {
                    <span class="computer-use-preview-warning" title="@Preview.CaptureError">Capture fallback active</span>
                }
            </div>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollLoop;
    private ComputerUsePreviewState? Preview { get; set; }
    private string? FrameDataUrl { get; set; }
    private bool Expanded { get; set; }

    private string DockClass
        => $"panel computer-use-preview-card {(Expanded ? "expanded" : "compact")}";

    private string PreviewTitle
        => string.Join(" · ", new[] { Preview?.Application, Preview?.WindowTitle }.Where(x => !string.IsNullOrWhiteSpace(x))!);

    private string CaptureBackendLabel
        => Preview?.CaptureBackend == "macos-screencapturekit-stream"
            ? "Native ScreenCaptureKit"
            : Preview?.CaptureBackend == "windows-graphics-capture-stream"
                ? "Native Windows Graphics Capture"
                : "Compatibility capture";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch
        {
            Preview = null;
            FrameDataUrl = null;
        }

        _pollLoop = PollAsync();
    }

    private async Task PollAsync()
    {
        while (!_cts.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(300), _cts.Token);
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested) { break; }
            catch
            {
                // Preview is best-effort. Agent update/restart or capture fallback must
                // never fault the Companion UI or weaken the Computer Use safety gate.
            }
        }
    }

    private async Task RefreshAsync()
    {
        Preview = await Api.GetComputerUsePreviewAsync(_cts.Token);
        if (Preview?.Active != true)
        {
            FrameDataUrl = null;
            return;
        }

        var frame = await Api.GetComputerUsePreviewFrameAsync(_cts.Token);
        FrameDataUrl = frame is { Bytes.Length: > 0 }
            ? $"data:{frame.MimeType};base64," + Convert.ToBase64String(frame.Bytes)
            : null;
    }

    private void ToggleExpanded() => Expanded = !Expanded;

    private static string Percent(double value)
        => (Math.Clamp(value, 0d, 1d) * 100d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_pollLoop is not null)
        {
            try { await _pollLoop; } catch (OperationCanceledException) { }
        }
        _cts.Dispose();
    }
}
